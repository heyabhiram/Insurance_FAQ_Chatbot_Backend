# TCS GenAI Lab LLM Configuration
TCS_API_KEY=
TCS_BASE_URL=https://genailab.tcs.in
TCS_MODEL=genailab-maas-gpt-4o
TCS_VERIFY_SSL=false

# Embedding & Vector Database Configuration
